# Public AI - Google Gemini
GEMINI_API_KEY=AQ.Ab8RN6JL_Ax9U05I6QAschLfPDxbGaSwaeC6_lS0PF5DOKjq3g
GEMINI_MODEL=gemini-3.5-flash-lite

# Private AI - local Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT=180

# Retrieval-Augmented Generation (Transformer embeddings + FAISS)
RAG_ENABLED=true
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=12

# Application
DATABASE_URL=sqlite:///./data/docfusion.db
UPLOAD_DIR=./data/uploads
GENERATED_DIR=./data/generated
VERIFICATION_DIR=./data/verification
KEY_DIR=./data/keys
MAX_UPLOAD_SIZE=10485760
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Role-based access (demo accounts are built in; override before real use)
AUTH_ENABLED=true
# AUTH_SECRET=
TOKEN_TTL_MINUTES=480
# DEMO_USERS=viewer1:change-me:viewer,analyst1:change-me:analyst,sup1:change-me:field_supervisor,admin1:change-me:admin
